# SBUniversity Backend Environment Variables

# Server Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:3000

# Database (Supabase PostgreSQL pooler or direct connection string)
# Example asyncpg URL: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Supabase Storage & Admin
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=sbu-storage

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
CLERK_ISSUER=https://clerk.your-domain.com
CLERK_WEBHOOK_SECRET=whsec_...

# Redis (Leaderboard, caching, pub/sub, rate limiting)
REDIS_URL=redis://localhost:6379/0

# Google Gemini (Aarsh Intelligence)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Security & Limits
RATE_LIMIT_ENABLED=true
ALLOW_DEV_AUTH_BYPASS=false
